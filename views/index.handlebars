<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Hello App</title>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
</head>

<body>
    <h1>A list of values</h1>
    <div id='container'>

    </div>
    <a href="/data">Download some json data</a>
</body>
<script>
    function Table() {
        function onSaveRow() {
            var $row = $(this).parent();
            var clave = $row.find('.field-clave').text();
            var valor = $row.find('.field-valor').val();

            $.ajax({
                url: '/line/' + clave,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ valor: valor }),
                success: function (response) {
                    console.log('Save successful:', response);
                },
                error: function (xhr, status, error) {
                    console.error('Save failed:', status, error);
                }
            });
        }
        function onDeleteRow() {
            var $row = $(this).parent();
            var clave = $row.find('.field-clave').text();

            $.ajax({
                url: '/line/' + clave,
                type: 'DELETE',
                contentType: 'application/json',
                success: function (response) {
                    console.log('Delete successful:', response);
                    $row.remove();
                },
                error: function (xhr, status, error) {
                    console.error('Delete failed:', status, error);
                }
            });

        }
        function make$Row(dataline) {
            dataline = dataline ?? {};
            var $newLine = $("<div></div>");
            var clave = dataline.id ?? crypto.randomUUID().substring(0, 8);
            var valor = dataline.valor ?? "";
            $newLine //
                .append('<span> Clave: </span>') //
                .append(
                    $(`<div style='display: inline-flex; width: 80px;' class='field-clave'/>${clave}</div>`));
            $newLine //
                .append('<span> Valor: </span>') //
                .append(
                    $(`<input type='text' class='field-valor'/>`) //
                        .val(valor));
            $newLine //
                .append(
                    $(`<button>save</button>`) //
                        .on('click', onSaveRow));
            $newLine //
                .append(
                    $('<button>-</button>') //
                        .on('click', onDeleteRow));
            return $newLine;
        }
        this.get$Table = function () {
            if (!$table) {
                // Añadimos la tabla al contenedor
                $table = $("<div id='table'></div>").appendTo("#container");

                // Añadimos una fila con boton +
                $lastLine = $("<div></div>").appendTo($table);
                $('<button>+</button>') //
                    .appendTo($lastLine) //
                    .on('click', function () {
                        make$Row().insertBefore($lastLine);
                    });
            }
            return $table;
        }
        this.init = function (data) {
            this.get$Table();
            if (data) {
                for (var dataline of data) {
                    make$Row(dataline).insertBefore($lastLine);
                }
            }

        }
        var $table;
        var $lastLine;
    }
    var table = new Table();
    $(document).ready(function () {
        $.ajax({
            url: '/lines',
            type: 'GET',
            success: function (data) {
                console.log('Initial data:', data);
                table.init(data);
            },
            error: function (xhr, status, error) {
                console.error('Failed to fetch initial data:', status, error);
            }
        });
    });
</script>

</html>